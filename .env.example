# Compose service URLs and local role credentials are configured in compose.yaml.
# PostgreSQL is intentionally not published to the host by default.
GATEWAY_URL=http://127.0.0.1:8080
DEBUGGER_URL=http://127.0.0.1:8081
TEMPO_URL=http://127.0.0.1:3200
APP_ENV=local
APP_VERSION=dev
WAIT_OBSERVER_ENABLED=true
LOCK_HOLD_DURATION=7.5s
